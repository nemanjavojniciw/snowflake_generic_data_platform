# Copy this file to compose/.env and fill in real values.
# docker-compose.yml reads this automatically when run from compose/.

# ── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PLATFORM_SVC
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=PLATFORM_ADMIN
SNOWFLAKE_WAREHOUSE=PLATFORM_WH
SNOWFLAKE_DATABASE=GENERIC_PLATFORM

# ── Airbyte (from: abctl local credentials after setup script) ───────────────
AIRBYTE_API_URL=http://host.docker.internal:8000/api/v1
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Web UI credentials (for reference)
AIRBYTE_EMAIL=airbyte
AIRBYTE_PASSWORD=

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── Git (auto-commit generated models) ───────────────────────────────────────
GIT_REPO_URL=
GIT_TOKEN=
GIT_BRANCH=main
