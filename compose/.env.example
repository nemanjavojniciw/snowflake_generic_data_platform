# ──────────────────────────────────────────────────────────────────────────────
# Snowflake — the only cloud dependency
# ──────────────────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account.region         # e.g. abc12345.us-east-1
SNOWFLAKE_USER=platform_svc
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=PLATFORM_ADMIN
SNOWFLAKE_WAREHOUSE=PLATFORM_WH
SNOWFLAKE_DATABASE=PLATFORM

# ──────────────────────────────────────────────────────────────────────────────
# Airbyte (local Docker — http://localhost:8000)
# ──────────────────────────────────────────────────────────────────────────────
AIRBYTE_API_URL=http://localhost:8000/api/v1
AIRBYTE_EMAIL=your_email                  # From `adcli credentials`
AIRBYTE_PASSWORD=your_password            # From `adcli credentials`
AIRBYTE_CLIENT_ID=your_client_id          # From `adcli credentials`
AIRBYTE_CLIENT_SECRET=your_client_secret  # From `adcli credentials`

# ──────────────────────────────────────────────────────────────────────────────
# Git (for committing generated dbt models programmatically)
# ──────────────────────────────────────────────────────────────────────────────
GIT_REPO_URL=https://github.com/yourorg/your-dbt-repo
GIT_TOKEN=ghp_your_token_here
GIT_BRANCH=main

# ──────────────────────────────────────────────────────────────────────────────
# Airflow Docker Compose (leave defaults for local dev)
# ──────────────────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
