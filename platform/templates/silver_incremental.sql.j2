with bronze as (
    select * from {{ ref(source_name + '__' + table_name) }}

    {% if is_incremental() %}
    where _extracted_at > (select coalesce(max(_extracted_at), '1900-01-01'::timestamp_ntz) from {{ this }})
    {% endif %}
),

deduped as (
    select
{% for col_name, col_info in columns.items() %}
