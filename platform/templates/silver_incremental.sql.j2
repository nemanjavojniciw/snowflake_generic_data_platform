        {{ col_name }},
{% endif %}
{% endfor %}
        _raw_id,
        _extracted_at,
        _loaded_at,
        row_number() over (
            partition by {{ primary_keys | join(', ') if primary_keys else 'id' }}
            order by _extracted_at desc
        ) as _rn

    from bronze
),

silver as (
    select
{% for col_name, col_info in columns.items() %}
{% if col_name not in ['_airbyte_raw_id', '_airbyte_extracted_at', '_airbyte_loaded_at', '_airbyte_data', '_bronze_created_at'] %}
        {{ col_name }},
{% endif %}
{% endfor %}
        _raw_id,
        _extracted_at,
        _loaded_at,
        current_timestamp() as _platform_updated_at

    from deduped
